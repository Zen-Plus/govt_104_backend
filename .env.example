# Copy to .env (same folder as docker-compose.yml) and fill in every value. NEVER commit .env.
# Use letters/digits only for passwords (they are embedded in the MongoDB URI):
#   openssl rand -hex 24

# ---- PostgreSQL ----
DB_USER=crm104
DB_PASSWORD=

# ---- MongoDB ----
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=crm104
MONGO_APP_PASSWORD=

# ---- Backend security ----
# >= 32 characters:            openssl rand -hex 32
JWT_SECRET=
# 32 random bytes, Base64:     openssl rand -base64 32
CRYPTO_KEY=
# Public URL(s) users open the app on, comma-separated
CORS_ORIGINS=http://localhost

# Demo accounts - set true only for a first test run, then false for production
SEED_USERS=false
SEED_PASSWORD=

# ---- Ports on the host ----
FRONTEND_PORT=80
BACKEND_PORT=8080
POSTGRES_PORT=5432
MONGO_PORT=27017

# Leave empty: the frontend calls /api on its own origin and nginx proxies it.
VITE_API_BASE=
